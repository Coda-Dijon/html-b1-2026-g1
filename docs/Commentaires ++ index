        <!-- Lien vers le validateur W3C, avec l'adresse de la page à tester dans "doc=" -->
        <td><a href="https://validator.w3.org/nu/?showoutline=yes&showimagereport=yes&level=warning&doc=https://coda-dijon.github.io/html-b1-2026-g1/"  target="_blank" rel="noopener" aria-label="Tester la page d'accueil avec le validateur W3C (s'ouvre dans un nouvel onglet)"> W3C </a></td>
    </tr>

    <!-- Ligne de Nathan (même structure) -->
    <tr>
